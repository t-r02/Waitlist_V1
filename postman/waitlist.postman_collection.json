  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Health check (initialises run variables)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseIngestion}}/actuator/health",
              "host": [
                "{{baseIngestion}}/actuator/health"
              ]
            },
            "header": []
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set('runEmail',    'e2e.' + ts + '@postman.test');",
                  "pm.environment.set('runRefEmail', 'ref.' + ts + '@postman.test');",
                  "pm.environment.set('bulkEmail1',  'bulk.' + ts + '.1@fixture.test');",
                  "pm.environment.set('bulkEmail2',  'bulk.' + ts + '.2@fixture.test');",
                  "pm.environment.set('bulkEmail3',  'bulk.' + ts + '.3@fixture.test');",
                  "['token','refCode','entryId','refEntryId','bulkId1','bulkId2','bulkId3'].forEach(k => pm.environment.set(k, ''));",
                  "console.log('runEmail:', pm.environment.get('runEmail'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ingestion-service UP', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fixture signup bulk-1 (for bulk tests)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseIngestion}}/api/public/signup",
              "host": [
                "{{baseIngestion}}/api/public/signup"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Forwarded-For",
                "value": "10.0.2.1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{bulkEmail1}}\",\"name\":\"Bulk Fixture 1\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bulk-1 registered', () => pm.expect([200,200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
