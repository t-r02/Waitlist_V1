{
  "info": {
    "name": "Waitlist Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"name\": \"John Doe\",\n  \"company\": \"Acme Inc\",\n  \"referralCode\": null\n}"
            },
            "url": "http://localhost:8081/api/public/signup"
          }
        },
        {
          "name": "Leaderboard",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/public/leaderboard"
          }
        }
      ]
    },
    {
      "name": "Admin API",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "http://localhost:8082/api/admin/auth/login"
          }
        },
        {
          "name": "List All Entries",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:8082/api/admin/entries"
          }
        },
        {
          "name": "Filter by Status",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:8082/api/admin/entries?status=PENDING"
          }
        },
        {
          "name": "Update Single Entry",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:8082/api/admin/entries/1?status=APPROVED"
          }
        },
        {
          "name": "Bulk Update",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [1, 2, 3],\n  \"newStatus\": \"APPROVED\"\n}"
            },
            "url": "http://localhost:8082/api/admin/entries/bulk"
          }
        }
      ]
    }
  ]
}
